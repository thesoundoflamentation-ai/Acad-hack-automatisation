    {
      "parameters": {
        "jsCode": "const first = $input.first().json;\nif (!Array.isArray(first.data)) throw new Error(\"Réponse inattendue de l'API (champ data absent) : \" + JSON.stringify(first).slice(0, 300));\nconst maintenant = new Date();\nreturn first.data.map(p => {\n  const cree = p.date_creation ? new Date(p.date_creation) : null;\n  const dernier = p.m08_dernier_envoi ? new Date(p.m08_dernier_envoi) : null;\n  const aRelancer = !!cree && !!p.email\n    && (maintenant - cree) > 3 * 86400000\n    && (!dernier || (maintenant - dernier) > 7 * 86400000);\n  return {\n    json: {\n      id: String(p.id), email: p.email || \"\", nom_commercial: p.nom_commercial || \"\",\n      payer_token: p.payer_token || \"\", a_relancer: aRelancer\n    },\n    pairedItem: { item: 0 }\n  };\n});"
      },
