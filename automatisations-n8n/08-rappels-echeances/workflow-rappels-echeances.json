    {
      "parameters": {
        "jsCode": "const first = $input.first().json;\nif (!Array.isArray(first.data)) throw new Error(\"Réponse inattendue de l'API (champ data absent) : \" + JSON.stringify(first).slice(0, 300));\nconst maintenant = new Date();\nreturn first.data.map(a => {\n  let fin = a.date_fin ? new Date(a.date_fin) : null;\n  // date seule (AAAA-MM-JJ) : l'adhésion court jusqu'à la fin de ce jour\n  if (fin && /^\\d{4}-\\d{2}-\\d{2}$/.test(String(a.date_fin))) fin = new Date(fin.getTime() + 86400000);\n  let action = \"rien\", cible = \"\", jours = null;\n  if (fin && fin < maintenant) {\n    action = \"echue\";\n  } else if (fin && a.email) {\n    jours = Math.ceil((fin - maintenant) / 86400000);\n    if (jours <= 30) { action = \"rappel\"; cible = \"J-30\"; }\n    else if (jours <= 90) { action = \"rappel\"; cible = \"J-90\"; }\n    if (action === \"rappel\" && a.m09_dernier_rappel === cible) action = \"rien\";\n  }\n  return {\n    json: {\n      id: String(a.id), email: a.email || \"\", nom_commercial: a.nom_commercial || \"\",\n      date_fin: a.date_fin || \"\", action, cible, jours_restants: jours\n    },\n    pairedItem: { item: 0 }\n  };\n});"
      },
