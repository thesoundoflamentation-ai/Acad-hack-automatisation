    },
    {
      "parameters": {
        "jsCode": "// ⚠️ Le source_id doit être IDENTIQUE à celui envoyé par la Flow Directus (webhook), sinon l'index contiendra des doublons.\n// Si la Flow envoie par exemple \"F12\" pour la fiche 12, renseigner PREFIXE.fiche = \"F\".\nconst PREFIXE = { fiche: \"\", page: \"\", faq: \"\" };\nconst BASE = \"https://madeleine-riviera.fr\";\nconst lire = (nom) => $(nom).all().flatMap(i => Array.isArray(i.json.data) ? i.json.data : []);\nconst out = [];\nfor (const f of lire(\"Lister les fiches\")) {\n  out.push({ json: { action: \"upsert\", source_type: \"fiche\", source_id: PREFIXE.fiche + String(f.id),\n    titre: f.nom_commercial || \"\", url: f.slug ? BASE + \"/fiche/\" + f.slug : \"\",\n    contenu: [f.nom_commercial, f.presentation].filter(Boolean).join(\"\\n\\n\") } });\n}\nfor (const p of lire(\"Lister les pages\")) {\n  out.push({ json: { action: \"upsert\", source_type: \"page\", source_id: PREFIXE.page + String(p.id),\n    titre: p.titre || \"\", url: p.slug ? BASE + \"/\" + p.slug : \"\",\n    contenu: [p.titre, p.contenu].filter(Boolean).join(\"\\n\\n\") } });\n}\nfor (const q of lire(\"Lister la FAQ\")) {\n  out.push({ json: { action: \"upsert\", source_type: \"faq\", source_id: PREFIXE.faq + String(q.id),\n    titre: q.question || \"\", url: BASE + \"/faq\",\n    contenu: [q.question, q.reponse].filter(Boolean).join(\"\\n\\n\") } });\n}\nif (out.length === 0) throw new Error(\"Aucun contenu publié récupéré : API Directus indisponible ou filtres incorrects\");\nreturn out;"
      },
