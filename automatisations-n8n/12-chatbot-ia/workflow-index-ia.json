    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const TAILLE = 800, CHEVAUCHEMENT = 100;\nconst texte = String($json.contenu || \"\");\nconst chunks = [];\nlet debut = 0;\nwhile (debut < texte.length) {\n  let fin = Math.min(debut + TAILLE, texte.length);\n  if (fin < texte.length) {\n    // coupure naturelle (fin de phrase ou de ligne) dans les 40 % finaux, sinon à l'espace le plus proche\n    const seuil = Math.floor(TAILLE * 0.6);\n    const zone = texte.slice(debut + seuil, fin);\n    const idx = Math.max(zone.lastIndexOf(\". \"), zone.lastIndexOf(\"! \"), zone.lastIndexOf(\"? \"), zone.lastIndexOf(\"\\n\"));\n    if (idx >= 0) fin = debut + seuil + idx + 1;\n    else {\n      const sp = texte.lastIndexOf(\" \", fin);\n      if (sp > debut + Math.floor(TAILLE * 0.5)) fin = sp;\n    }\n  }\n  const morceau = texte.slice(debut, fin).trim();\n  if (morceau) chunks.push(morceau);\n  if (fin >= texte.length) break;\n  let prochain = fin - CHEVAUCHEMENT;\n  const sp = texte.indexOf(\" \", prochain);\n  if (sp !== -1 && sp < fin) prochain = sp + 1;   // repartir au début d'un mot\n  debut = Math.max(prochain, debut + 1);\n}\n// Le titre est ajouté au texte envoyé au modèle (meilleure pertinence), mais pas au contenu stocké\nconst textes = chunks.map(c => $json.titre ? $json.titre + \"\\n\\n\" + c : c);\nreturn { json: {\n  source_type: $json.source_type, source_id: $json.source_id,\n  titre: $json.titre, url: $json.url,\n  chunks: chunks, textes_embedding: textes, nb: chunks.length\n} };"
      },
