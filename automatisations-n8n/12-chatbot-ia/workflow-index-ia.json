      "id": "ead58502-2c9c-4750-a2da-abddf09bfaa1",
      "name": "Supprimer de l'index",
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER",
          "name": "MR - PostgreSQL"
        }
