        "jsCode": "const n = $('Normaliser le contenu').item.json;\nif (!n.valide) return { json: { code: 400, corps: { erreur: n.erreur } } };\nif (n.action === \"delete\") {\n  return { json: { code: 200, corps: { supprime: true, source_type: n.source_type, source_id: n.source_id, vide: n.vide } } };\n}\nconst d = $('Assembler les lignes').item.json;\nreturn { json: { code: 200, corps: { indexe: true, nb_extraits: d.nb } } };"
