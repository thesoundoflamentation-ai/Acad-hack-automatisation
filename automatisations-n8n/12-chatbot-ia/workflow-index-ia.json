    {
      "parameters": {
        "method": "POST",
        "url": "https://api.cloudflare.com/client/v4/accounts/PLACEHOLDER_ACCOUNT_ID/ai/v1/embeddings",
        "sendHeaders": true,
        "headerParameters": {
