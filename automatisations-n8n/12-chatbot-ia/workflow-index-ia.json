    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let body = $json.body;\nif (typeof body === \"string\") { try { body = JSON.parse(body); } catch (e) { body = null; } }\nif (!body || typeof body !== \"object\" || Array.isArray(body)) body = $json;\nconst TYPES = [\"fiche\", \"page\", \"faq\"];\n// Texte brut : retire balises HTML, entités courantes et caractères nuls (refusés par PostgreSQL)\nconst nettoyer = (s) => String(s == null ? \"\" : s)\n  .replace(/\\u0000/g, \"\")\n  .replace(/<(script|style)[\\s\\S]*?<\\/\\1>/gi, \" \")\n  .replace(/<[^>]+>/g, \" \")\n  .replace(/&nbsp;/gi, \" \").replace(/&quot;/gi, '\"').replace(/&#39;|&apos;/gi, \"'\")\n  .replace(/&lt;/gi, \"<\").replace(/&gt;/gi, \">\").replace(/&amp;/gi, \"&\")\n  .replace(/[ \\t\\u00a0]+/g, \" \").replace(/\\s*\\n\\s*/g, \"\\n\").trim();\nconst action = String(body.action || \"\").trim().toLowerCase();\nconst source_type = String(body.source_type || \"\").trim().toLowerCase();\nconst source_id = String(body.source_id == null ? \"\" : body.source_id).trim().slice(0, 100);\nconst titre = nettoyer(body.titre).slice(0, 200);\nconst url = String(body.url || \"\").trim().slice(0, 500);\nconst contenu = nettoyer(body.contenu).slice(0, 20000);\nlet erreur = \"\";\nif (![\"upsert\", \"delete\"].includes(action)) erreur = \"action invalide (upsert ou delete attendu)\";\nelse if (!TYPES.includes(source_type)) erreur = \"source_type invalide (fiche, page ou faq attendu)\";\nelse if (!source_id) erreur = \"source_id requis\";\nelse if (url && !/^https:\\/\\/(www\\.)?madeleine-riviera\\.fr\\//.test(url)) erreur = \"url hors du domaine madeleine-riviera.fr\";\n// Un upsert sans contenu revient à retirer l'élément de l'index\nconst vide = !erreur && action === \"upsert\" && !contenu;\nreturn { json: {\n  valide: !erreur, erreur: erreur,\n  action: vide ? \"delete\" : action, vide: vide,\n  source_type: source_type, source_id: source_id,\n  titre: titre, url: url, contenu: contenu\n} };"
      },
