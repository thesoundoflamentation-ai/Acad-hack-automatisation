    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ctx = $('Découper en extraits').item.json;\nconst r = $json || {};\nconst lire = (arr) => arr.map(x => Array.isArray(x) ? x : (x && x.embedding));\nlet vecs = null;\nif (Array.isArray(r.data)) {\n  // format OpenAI (/ai/v1/embeddings) : [{ embedding, index }] ; format natif : [[...], [...]]\n  const d = r.data.slice();\n  if (d.length && !Array.isArray(d[0]) && d[0] && d[0].index != null) d.sort((a, b) => a.index - b.index);\n  vecs = lire(d);\n} else if (r.result && Array.isArray(r.result.data)) {\n  vecs = lire(r.result.data);\n}\nif (!Array.isArray(vecs) || vecs.length !== ctx.chunks.length) {\n  throw new Error(\"Embeddings reçus : \" + (vecs ? vecs.length : 0) + \", attendus : \" + ctx.chunks.length + \" — réponse : \" + JSON.stringify(r).slice(0, 200));\n}\nfor (const v of vecs) {\n  if (!Array.isArray(v) || v.length !== 1024 || !v.every(x => typeof x === \"number\" && isFinite(x))) {\n    throw new Error(\"Embedding invalide : 1024 nombres attendus (colonne vector(1024))\");\n  }\n}\nconst lignes = ctx.chunks.map((c, i) => ({\n  titre: ctx.titre || null, url: ctx.url || null, contenu: c, embedding: \"[\" + vecs[i].join(\",\") + \"]\"\n}));\nconst lignes_json = JSON.stringify(lignes);\nconst esc = (s) => String(s).replace(/'/g, \"''\");\nconst sql = \"WITH suppression AS (DELETE FROM ia_index WHERE source_type = '\" + esc(ctx.source_type) + \"' AND source_id = '\" + esc(ctx.source_id) + \"') INSERT INTO ia_index (source_type, source_id, titre, url, contenu, embedding) SELECT '\" + esc(ctx.source_type) + \"'::text, '\" + esc(ctx.source_id) + \"'::text, r.titre, r.url, r.contenu, r.embedding::vector FROM jsonb_to_recordset('\" + esc(lignes_json) + \"'::jsonb) AS r(titre text, url text, contenu text, embedding text)\";\nreturn { json: { source_type: ctx.source_type, source_id: ctx.source_id, nb: lignes.length, lignes_json: lignes_json, sql: sql } };"
      },
