    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ev = $(\"Extraire l'événement\").item.json;\nconst paiement = $(\"Relire le paiement HelloAsso\").item.json || {};\nconst commande = $json || {};\nconst isObj = (o) => o && typeof o === \"object\" && !Array.isArray(o);\nconst meta = [commande.metadata, paiement.metadata].find(isObj) || {};\nconst payer = [commande.payer, paiement.payer].find(p => isObj(p) && p.email) || {};\nconst orderId = (isObj(paiement.order) && paiement.order.id) || commande.id || ev.order_id || \"\";\nreturn { json: {\n  payment_id: ev.payment_id,\n  order_id: String(orderId),\n  montant_centimes: (paiement.amount != null) ? paiement.amount : null,\n  date_paiement: paiement.date || \"\",\n  state_paiement: paiement.state || \"\",\n  adhesion_id: String(meta.adhesion_id || \"\"),\n  payer_token: String(meta.payer_token || \"\"),\n  payer_email: String(payer.email || \"\"),\n  payer_prenom: String(payer.firstName || \"\"),\n  payer_nom: String(payer.lastName || \"\")\n} };"
      },
