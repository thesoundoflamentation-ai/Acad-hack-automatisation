        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: \"bureau@madeleine-riviera.fr\", subject: \"⚠️ Paiement HelloAsso à rattacher à la main\", text: \"Le rattrapage a trouvé le paiement HelloAsso n° \" + $json.payment_id + \" (\" + (($json.montant_centimes || 0) / 100).toFixed(2).replace(\".\", \",\") + \" €) sans adhesion_id ni payer_token.\\n\\nIl n'a pas été enregistré sur le site. À rapprocher à la main de la demande d'adhésion.\\n\\nE-mail du payeur : \" + ($json.payer_email || \"inconnu\") + \"\\nCommande HelloAsso n° \" + $json.order_id }) }}",
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
