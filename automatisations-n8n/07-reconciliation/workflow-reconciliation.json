      "id": "0b2c39b6-08f3-49d7-902d-21ef5c84d12c",
      "name": "Lire la commande HelloAsso"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const p = $(\"Déplier les paiements\").item.json;\nconst commande = $json || {};\nconst isObj = (o) => o && typeof o === \"object\" && !Array.isArray(o);\nconst meta = [commande.metadata, p.metadata].find(m => isObj(m) && Object.keys(m).length > 0) || {};\nconst payer = [commande.payer, p.payer].find(x => isObj(x) && x.email) || {};\nreturn { json: {\n  payment_id: p.payment_id,\n  order_id: p.order_id || String(commande.id || \"\"),\n  montant_centimes: p.montant_centimes,\n  date_paiement: p.date_paiement,\n  adhesion_id: String(meta.adhesion_id || \"\"),\n  payer_token: String(meta.payer_token || \"\"),\n  payer_email: String(payer.email || \"\"),\n  payer_prenom: String(payer.firstName || \"\"),\n  payer_nom: String(payer.lastName || \"\")\n} };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1184,
        -192
      ],
      "id": "b2254059-eb83-486f-98e7-03c03af401d2",
