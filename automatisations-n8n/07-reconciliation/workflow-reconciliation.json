    {
      "parameters": {
        "url": "=https://api.helloasso-sandbox.com/v5/organizations/madeleine-riviera/payments?from={{ encodeURIComponent($now.minus(1, \"days\").toISO()) }}&to={{ encodeURIComponent($now.toISO()) }}&pageSize=100",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $(\"Token OAuth2 HelloAsso\").item.json.access_token }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        -192,
        -160
      ],
      "id": "422472e7-5c72-4215-8be0-b599c152a29a",
      "name": "Lister les paiements de la veille"
    },
    {
      "parameters": {
        "jsCode": "const first = $input.item.json;\nconst d = Array.isArray(first.data) ? first.data : [];\nconst isObj = (o) => o && typeof o === \"object\" && !Array.isArray(o);\nreturn d.map(p => ({\n  json: {\n    payment_id: String(p.id),\n    order_id: String(p.order && p.order.id != null ? p.order.id : (p.orderId != null ? p.orderId : \"\")),\n    montant_centimes: (p.amount != null) ? p.amount : null,\n    date_paiement: p.date || \"\",\n    state: p.state || \"\",\n    metadata: isObj(p.metadata) ? p.metadata : {},\n    payer: isObj(p.payer) ? p.payer : {}\n  },\n  pairedItem: { item: 0 }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        32,
        -160
      ],
      "id": "15a7ce01-8c47-41f4-95f7-63eec46e8280",
