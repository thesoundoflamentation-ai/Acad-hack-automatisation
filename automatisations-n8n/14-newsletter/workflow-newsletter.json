        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: $json.email, subject: $('Normaliser la demande').item.json.sujet, text: $('Normaliser la demande').item.json.texte + \"\\n\\n---\\nAssociation Madeleine Riviera — boulevard de la Madeleine, Nice.\\nVous recevez ce message car vous avez coché « newsletter » lors de votre adhésion.\\nPour ne plus recevoir la newsletter : répondez « STOP » à ce message ou connectez-vous à votre espace.\\n\" }) }}",
