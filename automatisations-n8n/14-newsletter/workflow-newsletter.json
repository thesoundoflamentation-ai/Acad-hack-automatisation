    {
      "parameters": {
        "jsCode": "let body = $json.body;\nif (typeof body === \"string\") { try { body = JSON.parse(body); } catch (e) { body = null; } }\nif (!body || typeof body !== \"object\" || Array.isArray(body)) body = $json;\nconst sujet = String(body.sujet || \"\").trim().slice(0, 200);\nconst texte = String(body.texte || \"\").trim().slice(0, 20000);\nreturn { json: { sujet, texte, valide: !!(sujet && texte) } };"
      },
      "type": "n8n-nodes-base.code",
