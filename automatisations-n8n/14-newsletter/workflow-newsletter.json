    {
      "parameters": {
        "jsCode": "const tous = $input.all().map(i => i.json);\nconst dest = $('Déplier les destinataires').all().map(i => i.json.email);\nconst ok = (x) => !(x && x.error);\nconst envoyes = tous.filter(ok).length;\nconst erreurs = tous.length - envoyes;\nreturn [{ json: {\n  sujet: $('Normaliser la demande').item.json.sujet,\n  envoyes, erreurs, total: tous.length,\n  destinataires: dest.filter((_, i) => ok(tous[i]))\n} }];"
      },
